{
	"name": "discord-bun-template",
	"version": "1.0.0",
	"description": "Slash-command Discord bot template on Bun, TypeScript and discord.js.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"deploy": "bun src/deploy.ts",
		"deploy:global": "bun src/deploy.ts --global",
		"deploy:clear": "bun src/deploy.ts --clear",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"discord.js": "^14.28.1"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
